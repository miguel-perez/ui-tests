    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "playwright-core": "1.64.1",
    "rrweb": "2.1.7",
    "rrweb-player": "2.1.7",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
